# Copy this file to .env and add only the credentials you choose to use.
# Never commit your populated .env file.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Required by the private, single-user profile implementation.
SUPABASE_SERVICE_ROLE_KEY=

# Primary LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Prints validated structured output to the local Streamlit terminal. May contain PII.
GEMINI_DEBUG_RESPONSE=false

# Optional fallback LLM
GROQ_API_KEY=

# Optional job and web search
TAVILY_API_KEY=

# Local terminal logging (DEBUG, INFO, WARNING, ERROR)
JOBPILOT_LOG_LEVEL=INFO
